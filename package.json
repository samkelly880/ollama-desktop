{
  "name": "ollama-desktop",
  "version": "0.1.0",
  "description": "An unofficial Linux desktop app (GUI) for a locally running Ollama server.",
  "desktopName": "ollama-desktop.desktop",
  "main": "./out/main/index.js",
  "author": {
    "name": "samkelly880",
    "email": "293011299+samkelly880@users.noreply.github.com"
  },
  "homepage": "https://github.com/samkelly880/ollama-desktop",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:no-sandbox": "electron-vite dev -- --no-sandbox",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "build": "npm run typecheck && electron-vite build && electron-builder --linux",
    "build:dir": "electron-vite build && electron-builder --linux --dir",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
